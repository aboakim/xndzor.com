generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  name             String
  phone            String?
  role             String             @default("FARMER") // FARMER | BUYER | PROVIDER | BOTH | ADMIN
  /// Public Farm Passport ID, e.g. AR-002184 (display as #AR-002184)
  farmId           String?            @unique
  /// Manual or criteria-based verified farm badge
  farmVerified     Boolean            @default(false)
  /// Optional: show phone on public Farm Passport (default hidden)
  showPhoneOnPassport Boolean         @default(false)
  /// Profile photo URL (public/uploads/avatars/…)
  avatarUrl        String?
  /// PUBLIC | REGISTERED | HIDDEN — who can see profile on listings
  profileVisibility String           @default("PUBLIC")
  /// Per-field public visibility (when profile is not hidden)
  showPhonePublic   Boolean           @default(false)
  showAvatarPublic  Boolean           @default(true)
  showMarzPublic    Boolean           @default(true)
  showVillagePublic Boolean           @default(false)
  /// Optional public farm display name (falls back to user name)
  farmName         String?
  /// Admin can suspend account — login blocked while true
  suspended        Boolean            @default(false)
  /// True after user successfully claims a free early-bird package (not on register)
  earlyBirdFree    Boolean            @default(false)
  /// When the user claimed their free early-bird slot (decrements remaining spots)
  earlyBirdClaimedAt DateTime?
  /// Monetization entitlements (synced from Subscription / Payment)
  isPro            Boolean            @default(false)
  proUntil         DateTime?
  isVerifiedPaid   Boolean            @default(false)
  verifiedPaidUntil DateTime?
  buyerProUntil    DateTime?
  marzId           String?
  marz             Marz?              @relation(fields: [marzId], references: [id])
  villageId        String?
  village          Village?           @relation(fields: [villageId], references: [id])
  createdAt        DateTime           @default(now())
  demands          Demand[]
  supplies         Supply[]
  offers           Offer[]
  jobRequests      JobRequest[]
  providers        ServiceProvider[]
  jobApplications  JobApplication[]
  futureHarvests   FutureHarvest[]
  preOffers        PreOffer[]
  groupCampaigns   GroupBuyCampaign[]
  groupJoins       GroupBuyJoin[]
  plots            Plot[]
  machineryListings MachineryListing[]
  animalListings    AnimalListing[]
  catalogListings   CatalogListing[]
  comments          Comment[]
  productBatches    ProductBatch[]
  farmReviewsReceived FarmReview[]    @relation("FarmReviewsReceived")
  farmReviewsGiven    FarmReview[]    @relation("FarmReviewsGiven")
  subscriptions    Subscription[]
  boosts           Boost[]
  payments         Payment[]
  demandAlerts     DemandAlert[]
  farmExpenses     FarmExpense[]
  farmDiaryEntries FarmDiaryEntry[]
  spaceListings    SpaceListing[]
  returnOffers     ReturnCapacityOffer[]
  cropJourneys     CropJourney[]
  villageGoalJoins VillageGoalJoin[]

  @@index([villageId])
  @@index([farmId])
  @@index([isPro])
}

model Marz {
  id             String             @id
  slug           String             @unique
  nameHy         String
  nameEn         String
  nameRu         String
  sortOrder      Int                @default(0)
  villages       Village[]
  users          User[]
  demands        Demand[]
  supplies       Supply[]
  jobRequests    JobRequest[]
  providers      ServiceProvider[]
  futureHarvests FutureHarvest[]
  campaigns      GroupBuyCampaign[]
  plots          Plot[]
  machineryListings MachineryListing[]
  animalListings    AnimalListing[]
  catalogListings   CatalogListing[]
  spaceListings     SpaceListing[]
}

model Village {
  id             String            @id
  slug           String            @unique
  marzId         String
  marz           Marz              @relation(fields: [marzId], references: [id])
  nameHy         String
  nameEn         String
  nameRu         String
  kind           String            @default("settlement")
  /// WGS84 centre of the settlement, used for the village map page
  lat            Float?
  lng            Float?
  users          User[]
  demands        Demand[]
  supplies       Supply[]
  jobRequests    JobRequest[]
  providers      ServiceProvider[]
  futureHarvests FutureHarvest[]
  plots          Plot[]
  machineryListings MachineryListing[]
  animalListings    AnimalListing[]
  catalogListings   CatalogListing[]
  spaceListings     SpaceListing[]
  villageGoals      VillageGoal[]

  @@index([marzId])
  @@index([nameEn])
  @@index([nameHy])
}

model Product {
  id             String             @id @default(cuid())
  slug           String             @unique
  nameKey        String
  sortOrder      Int                @default(0)
  demands        Demand[]
  supplies       Supply[]
  futureHarvests FutureHarvest[]
  campaigns      GroupBuyCampaign[]
  plots          Plot[]
  productBatches ProductBatch[]
  demandAlerts   DemandAlert[]
}

/// Buyer need: Գնել
model Demand {
  id           String    @id @default(cuid())
  title        String
  description  String
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  qtyMin       Int
  qtyMax       Int?
  unit         String
  priceMinAmd  Int?
  priceMaxAmd  Int?
  /// FACTORY | SHOP_CHAIN | RESTAURANT | WHOLESALE | EXPORTER | OTHER
  buyerKind    String    @default("WHOLESALE")
  timingNote   String?
  neededBy     DateTime?
  status       String    @default("ACTIVE")
  marzId       String
  marz         Marz      @relation(fields: [marzId], references: [id])
  villageId    String?
  village      Village?  @relation(fields: [villageId], references: [id])
  phone        String
  whatsapp     String?
  imageUrls    String    @default("[]")
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  offers       Offer[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId])
  @@index([marzId])
  @@index([status])
  @@index([buyerKind])
}

/// Farmer sell: Վաճառել
model Supply {
  id           String    @id @default(cuid())
  title        String
  description  String
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  qtyAvailable Int
  unit         String
  priceAmd     Int?
  readyInDays  Int       @default(0)
  status       String    @default("ACTIVE")
  /// Paid «Շտապ վաճառք» homepage placement — active while urgentUntil > now
  urgentUntil  DateTime?
  marzId       String
  marz         Marz      @relation(fields: [marzId], references: [id])
  villageId    String?
  village      Village?  @relation(fields: [villageId], references: [id])
  phone        String
  whatsapp     String?
  imageUrls    String    @default("[]")
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  offers       Offer[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId])
  @@index([marzId])
  @@index([status])
  @@index([urgentUntil])
}

model Offer {
  id         String   @id @default(cuid())
  supplyId   String
  supply     Supply   @relation(fields: [supplyId], references: [id])
  demandId   String
  demand     Demand   @relation(fields: [demandId], references: [id])
  fromUserId String
  fromUser   User     @relation(fields: [fromUserId], references: [id])
  message    String?
  status     String   @default("SENT")
  createdAt  DateTime @default(now())

  @@unique([supplyId, demandId, fromUserId])
  @@index([demandId])
  @@index([supplyId])
}

/// Job request: Պատվիրել աշխատանք (not machinery classifieds)
model JobRequest {
  id           String           @id @default(cuid())
  jobType      String // PLOW | SOW | SPRAY | HARVEST | TRANSPORT | PRUNE | GREENHOUSE | CONSULT | OTHER
  title        String
  description  String
  hectares     Float?
  areaNote     String?
  workDate     DateTime?
  dateFrom     DateTime?
  dateTo       DateTime?
  budgetAmd    Int?
  status       String           @default("ACTIVE") // ACTIVE | FILLED | HIDDEN
  marzId       String
  marz         Marz             @relation(fields: [marzId], references: [id])
  villageId    String?
  village      Village?         @relation(fields: [villageId], references: [id])
  phone        String
  whatsapp     String?
  imageUrls    String           @default("[]")
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  applications JobApplication[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([jobType])
  @@index([marzId])
  @@index([status])
}

/// Provider capacity: Կատարել աշխատանք
model ServiceProvider {
  id            String           @id @default(cuid())
  title         String
  description   String
  jobTypesJson  String           @default("[]") // JSON string[] of job types
  coverageNote  String?
  hectaresMax   Float?
  rateAmd       Int?
  rateUnit      String? // ha | day | job
  availableFrom DateTime?
  availableTo   DateTime?
  status        String           @default("ACTIVE") // ACTIVE | BUSY | HIDDEN
  marzId        String
  marz          Marz             @relation(fields: [marzId], references: [id])
  villageId     String?
  village       Village?         @relation(fields: [villageId], references: [id])
  phone         String
  whatsapp      String?
  imageUrls     String           @default("[]")
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  applications  JobApplication[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([marzId])
  @@index([status])
}

model JobApplication {
  id               String          @id @default(cuid())
  jobRequestId     String
  jobRequest       JobRequest      @relation(fields: [jobRequestId], references: [id])
  providerId       String
  provider         ServiceProvider @relation(fields: [providerId], references: [id])
  fromUserId       String
  fromUser         User            @relation(fields: [fromUserId], references: [id])
  message          String?
  proposedPriceAmd Int?
  status           String          @default("SENT") // SENT | ACCEPTED | DECLINED
  createdAt        DateTime        @default(now())

  @@unique([jobRequestId, providerId])
  @@index([jobRequestId])
  @@index([providerId])
}

/// Land plot — FarmOS core
model Plot {
  id               String         @id @default(cuid())
  name             String
  hectares         Float
  cropProductId    String
  cropProduct      Product        @relation(fields: [cropProductId], references: [id])
  plantDate        DateTime
  irrigationNotes  String?
  lastFertilizer   String?
  lastIrrigationAt DateTime?
  harvestFrom      DateTime?
  harvestTo        DateTime?
  status           String         @default("ACTIVE") // ACTIVE | HARVESTED | ARCHIVED
  marzId           String
  marz             Marz           @relation(fields: [marzId], references: [id])
  villageId        String?
  village          Village?       @relation(fields: [villageId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  photoUrls        String         @default("[]")
  photoNote        String? // plant-photo assist stub + disclaimer
  tasks            PlotTask[]
  yieldEstimate    YieldEstimate?
  futureHarvests   FutureHarvest[]
  productBatches   ProductBatch[]
  farmExpenses     FarmExpense[]
  farmDiaryEntries FarmDiaryEntry[]
  cropJourneys     CropJourney[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([marzId])
  @@index([cropProductId])
  @@index([status])
}

/// Today / upcoming farm tasks for a plot
model PlotTask {
  id        String    @id @default(cuid())
  plotId    String
  plot      Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  kind      String // IRRIGATION | PEST | WEATHER | HARVEST | FERTILIZER | CUSTOM
  title     String
  detail    String?
  dueDate   DateTime?
  status    String    @default("OPEN") // OPEN | DONE | SKIPPED
  priority  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([plotId])
  @@index([status])
  @@index([dueDate])
}

/// Rule-based yield estimate (tons); farmer can override
model YieldEstimate {
  id                 String   @id @default(cuid())
  plotId             String   @unique
  plot               Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)
  tonsMin            Float
  tonsMax            Float
  unit               String   @default("ton")
  assumptionNote     String
  farmerOverrideTons Float?
  source             String   @default("RULE_TABLE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Future harvest listing (pre-sale) — marketplace module linked from plot
model FutureHarvest {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  plotId      String?
  plot        Plot?      @relation(fields: [plotId], references: [id])
  title       String
  description String
  qtyExpected Int
  unit        String
  harvestDate DateTime
  priceAmd    Int?
  status      String     @default("ACTIVE") // ACTIVE | RESERVED | SOLD | HIDDEN
  marzId      String
  marz        Marz       @relation(fields: [marzId], references: [id])
  villageId   String?
  village     Village?   @relation(fields: [villageId], references: [id])
  phone       String
  whatsapp    String?
  imageUrls   String     @default("[]")
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  preOffers   PreOffer[]
  productBatches ProductBatch[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([productId])
  @@index([marzId])
  @@index([status])
  @@index([plotId])
}

/// Buyer pre-offer / reserve qty on a future harvest
model PreOffer {
  id              String        @id @default(cuid())
  futureHarvestId String
  futureHarvest   FutureHarvest @relation(fields: [futureHarvestId], references: [id])
  fromUserId      String
  fromUser        User          @relation(fields: [fromUserId], references: [id])
  qtyWanted       Int
  message         String?
  status          String        @default("SENT") // SENT | RESERVED | DECLINED
  createdAt       DateTime      @default(now())

  @@unique([futureHarvestId, fromUserId])
  @@index([futureHarvestId])
}

/// Group buy: Միանալ խմբային գնմանը
model GroupBuyCampaign {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  title           String
  description     String
  targetQty       Int
  unit            String
  pricePerUnitAmd Int?
  deadline        DateTime?
  status          String         @default("OPEN") // OPEN | QUOTED | CLOSED
  supplierNote    String?
  marzId          String?
  marz            Marz?          @relation(fields: [marzId], references: [id])
  organizerId     String
  organizer       User           @relation(fields: [organizerId], references: [id])
  imageUrls       String         @default("[]")
  joins           GroupBuyJoin[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([productId])
  @@index([status])
}

model GroupBuyJoin {
  id         String           @id @default(cuid())
  campaignId String
  campaign   GroupBuyCampaign @relation(fields: [campaignId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  qty        Int
  status     String           @default("JOINED") // JOINED | LEFT
  createdAt  DateTime         @default(now())

  @@unique([campaignId, userId])
  @@index([campaignId])
}

/// Agricultural machinery for sale (inventory-style marketplace; not job orders)
model MachineryListing {
  id              String   @id @default(cuid())
  title           String
  description     String
  /// TRACTOR | COMBINE | TRAILER | CULTIVATOR | SPRAYER | TRUCK | SEEDER | OTHER
  machineryType   String
  make            String
  model           String
  year            Int
  engineHours     Int?
  mileageKm       Int?
  /// NEW | USED | FOR_PARTS
  condition       String   @default("USED")
  priceAmd        Int?
  priceNegotiable Boolean  @default(false)
  powerHp         Int?
  transmission    String?
  driveType       String?
  fuel            String?
  workingWidth    String?
  capacity        String?
  attachments     String?
  documentsNote   String?
  /// ACTIVE | SOLD | HIDDEN
  status          String   @default("ACTIVE")
  marzId          String
  marz            Marz     @relation(fields: [marzId], references: [id])
  villageId       String?
  village         Village? @relation(fields: [villageId], references: [id])
  phone           String
  whatsapp        String?
  imageUrls       String   @default("[]")
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([machineryType])
  @@index([marzId])
  @@index([status])
  @@index([year])
  @@index([priceAmd])
  @@index([userId])
}

/// Livestock / domestic animals for sale (inventory marketplace)
model AnimalListing {
  id              String   @id @default(cuid())
  title           String
  description     String
  /// CATTLE | COW | BULL | SHEEP | GOAT | PIG | HORSE | CHICKEN | TURKEY | BEE_COLONY | DOG | OTHER
  animalType      String
  breed           String
  /// MALE | FEMALE | MIXED
  sex             String   @default("MIXED")
  ageValue        Int?
  /// MONTHS | YEARS
  ageUnit         String   @default("MONTHS")
  weightKg        Float?
  /// Head count / colony count
  quantity        Int      @default(1)
  /// MEAT | DAIRY | BREEDING | WORK | PET | OTHER
  purpose         String   @default("OTHER")
  vaccinated      Boolean  @default(false)
  healthNotes     String?
  documentsNote   String?
  pedigreeNote    String?
  priceAmd        Int?
  priceNegotiable Boolean  @default(false)
  /// PER_HEAD | LOT
  priceMode       String   @default("LOT")
  /// ACTIVE | SOLD | HIDDEN
  status          String   @default("ACTIVE")
  marzId          String
  marz            Marz     @relation(fields: [marzId], references: [id])
  villageId       String?
  village         Village? @relation(fields: [villageId], references: [id])
  phone           String
  whatsapp        String?
  imageUrls       String   @default("[]")
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([animalType])
  @@index([marzId])
  @@index([status])
  @@index([purpose])
  @@index([priceAmd])
  @@index([userId])
}

/// Unified ag marketplace catalog (fertilizer, seed, feed, chemical, tool, land)
model CatalogListing {
  id              String    @id @default(cuid())
  /// FERTILIZER | SEED | FEED | CHEMICAL | TOOL | LAND
  category        String
  /// Category-specific subtype (e.g. NPK, ORGANIC, WHEAT, HERBICIDE…)
  subtype         String
  title           String
  description     String
  brand           String?
  /// JSON bag of extra fields (NPK ratio, hectares, waterAccess, etc.)
  specsJson       String    @default("{}")
  quantity        Float?
  unit            String?
  packageSize     String?
  priceAmd        Int?
  priceNegotiable Boolean   @default(false)
  /// PER_KG | PER_BAG | PER_LITER | PER_HA | LOT | OTHER
  priceUnit       String    @default("LOT")
  expiryDate      DateTime?
  /// ACTIVE | SOLD | HIDDEN
  status          String    @default("ACTIVE")
  marzId          String
  marz            Marz      @relation(fields: [marzId], references: [id])
  villageId       String?
  village         Village?  @relation(fields: [villageId], references: [id])
  phone           String
  whatsapp        String?
  imageUrls       String    @default("[]")
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([subtype])
  @@index([marzId])
  @@index([status])
  @@index([priceAmd])
  @@index([userId])
}

/// User comments / reviews on marketplace listings
model Comment {
  id         String   @id @default(cuid())
  /// MACHINERY | ANIMAL | CATALOG
  targetType String
  targetId   String
  body       String
  /// Optional 1–5 star rating
  rating     Int?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([userId])
  @@index([createdAt])
}

/// Product Passport — harvest batch with traceable origin
model ProductBatch {
  id              String         @id @default(cuid())
  /// Public code e.g. TOMATO-AR-2026-00182
  batchCode       String         @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  plotId          String?
  plot            Plot?          @relation(fields: [plotId], references: [id])
  futureHarvestId String?
  futureHarvest   FutureHarvest? @relation(fields: [futureHarvestId], references: [id])
  qtyTons         Float
  harvestDate     DateTime
  publishedAt     DateTime       @default(now())
  /// PUBLISHED | HIDDEN
  status          String         @default("PUBLISHED")
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([plotId])
  @@index([futureHarvestId])
  @@index([status])
  @@index([batchCode])
}

/// Buyer rating of a farm after a completed interaction (pre-offer / offer context)
model FarmReview {
  id          String   @id @default(cuid())
  farmUserId  String
  farmUser    User     @relation("FarmReviewsReceived", fields: [farmUserId], references: [id])
  fromUserId  String
  fromUser    User     @relation("FarmReviewsGiven", fields: [fromUserId], references: [id])
  /// 1–5 stars
  rating      Int
  body        String?
  /// Optional context links (not enforced FK for flexibility)
  preOfferId  String?
  offerId     String?
  createdAt   DateTime @default(now())

  @@index([farmUserId])
  @@index([fromUserId])
  @@index([createdAt])
}

/// Catalog of sellable plans (seeded; prices also in src/lib/pricing.ts)
model Plan {
  id          String   @id @default(cuid())
  code        String   @unique
  /// FARM_PRO | BUYER_PRO | VERIFIED_FARM | BOOST | URGENT
  kind        String
  nameKey     String
  amountAmd   Int
  /// MONTHLY | YEARLY | ONE_TIME | DAYS_7 | DAYS_30
  interval    String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  /// Plan code e.g. FARM_PRO_MONTHLY
  planCode             String
  /// ACTIVE | CANCELED | EXPIRED | PAST_DUE
  status               String   @default("ACTIVE")
  currentPeriodEnd     DateTime
  stripeSubscriptionId String?  @unique
  stripeCustomerId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([planCode])
}

/// Featured listing boost (machinery / animal / catalog / supply / future harvest)
model Boost {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  /// MACHINERY | ANIMAL | CATALOG | SUPPLY | FUTURE_HARVEST
  targetType String
  targetId   String
  days       Int
  startsAt   DateTime  @default(now())
  endsAt     DateTime
  /// PAID | PRO_QUOTA
  source     String    @default("PAID")
  paymentId  String?
  payment    Payment?  @relation(fields: [paymentId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([targetType, targetId])
  @@index([endsAt])
  @@index([userId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  amountAmd       Int
  /// Stripe charge amount in smallest currency unit (e.g. USD cents)
  amountCharge    Int?
  currencyCharge  String   @default("usd")
  /// PENDING | SUCCEEDED | FAILED | CANCELED
  status          String   @default("PENDING")
  /// STRIPE | DEMO | IDRAM | TELCELL | FREE | BANK_TRANSFER
  provider        String
  providerRef     String?
  /// Stripe Checkout Session id (idempotency)
  stripeSessionId String?  @unique
  /// Product / SKU code from pricing config
  productCode     String
  metadataJson    String   @default("{}")
  /// Last 4 digits of card (never store full PAN/CVV)
  cardLast4       String?
  cardholderName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  boosts          Boost[]
  otpVerification OtpVerification?

  @@index([userId])
  @@index([status])
  @@index([providerRef])
  @@index([createdAt])
}

/// ARCA / bank SMS OTP for card checkout (demo + future ArCa gateway)
model OtpVerification {
  id        String   @id @default(cuid())
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// Pro farmers: crop demand alerts (gated behind Farm Pro)
model DemandAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

/// Farm OS — expense logging («Ո՞ւր է գնում իմ փողը»)
model FarmExpense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  plotId    String?
  plot      Plot?    @relation(fields: [plotId], references: [id], onDelete: SetNull)
  /// diesel | labor | seed | water | other
  category  String
  amountAmd Int
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([plotId])
  @@index([category])
  @@index([date])
}

/// Farm OS — voice / text diary day report
model FarmDiaryEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  plotId          String?
  plot            Plot?    @relation(fields: [plotId], references: [id], onDelete: SetNull)
  rawText         String
  /// JSON: { wateredHa?, fertilizerKg?, workersTomorrow?, keywords[] }
  parsedJson      String   @default("{}")
  entryDate       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([plotId])
  @@index([entryDate])
}

/// Empty warehouse / cold / silo / greenhouse / dryer / land space listings
model SpaceListing {
  id              String    @id @default(cuid())
  title           String
  description     String    @default("")
  /// WAREHOUSE | COLD | SILO | GREENHOUSE | DRYER | LAND
  spaceType       String
  /// Optional area (m² or ha — see areaUnit)
  area            Float?
  areaUnit        String    @default("m2")
  capacityNote    String?
  availableFrom   DateTime?
  availableTo     DateTime?
  priceAmd        Int?
  /// PER_DAY | PER_MONTH | LOT
  priceUnit       String    @default("PER_MONTH")
  status          String    @default("ACTIVE") // ACTIVE | BOOKED | HIDDEN
  marzId          String
  marz            Marz      @relation(fields: [marzId], references: [id])
  villageId       String?
  village         Village?  @relation(fields: [villageId], references: [id])
  phone           String    @default("")
  imageUrls       String    @default("[]")
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([spaceType])
  @@index([marzId])
  @@index([status])
  @@index([userId])
}

/// Empty-return truck capacity («դատարկ վերադարձ»)
model ReturnCapacityOffer {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  fromNote     String
  toNote       String
  fromMarzId   String?
  toMarzId     String?
  freeTons     Float?
  priceAmd     Int?
  departAt     DateTime?
  dateHint     String?
  capacityNote String?
  phone        String?
  status       String    @default("OPEN") // OPEN | MATCHED | CLOSED
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@index([departAt])
}

/// Seed-to-sale crop journey with stage costs
model CropJourney {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  plotId       String?
  plot         Plot?    @relation(fields: [plotId], references: [id], onDelete: SetNull)
  cropName     String
  seasonYear   Int
  /// JSON stages: [{ id, title, costAmd, note? }]
  stagesJson   String   @default("[]")
  totalCostAmd Int      @default(0)
  yieldKg      Float?
  revenueAmd   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([plotId])
  @@index([seasonYear])
}

/// Shared village goals («Գյուղը միասին»)
model VillageGoal {
  id          String            @id @default(cuid())
  villageId   String
  village     Village           @relation(fields: [villageId], references: [id])
  title       String
  targetQty   Float
  unit        String            @default("ton")
  progressQty Float             @default(0)
  status      String            @default("OPEN") // OPEN | DONE | CANCELLED
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  joins       VillageGoalJoin[]

  @@index([villageId])
  @@index([status])
}

model VillageGoalJoin {
  id        String      @id @default(cuid())
  goalId    String
  goal      VillageGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  qty       Float
  createdAt DateTime    @default(now())

  @@unique([goalId, userId])
  @@index([userId])
}
