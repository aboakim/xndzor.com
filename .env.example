# ─── Database (PostgreSQL — required for Vercel / production) ───────────────
# Local Docker Compose: postgresql://xndzor:xndzor@localhost:5432/xndzor
# Neon (recommended for Vercel): copy the pooled connection string from console.neon.tech
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
#
# After setting the URL: npx prisma db push
# Optional sample data: npm run db:seed
DATABASE_URL="postgresql://xndzor:xndzor@localhost:5432/xndzor"

# ─── Auth (required in production) ──────────────────────────────────────────
# Public site origin — MUST match the live URL (no trailing slash).
# Apex redirects to www → use https://www.xndzor.com on Vercel.
NEXTAUTH_URL="http://localhost:3000"
# Alias used by some Auth.js builds (set to the same value)
AUTH_URL="http://localhost:3000"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: public contact email (security reports, contact page)
CONTACT_EMAIL="hello@xndzor.com"
NEXT_PUBLIC_CONTACT_EMAIL="hello@xndzor.com"


# ─── Stripe (cards: Visa, Mastercard, ArCa) ───────────────────────────────
# Required for card checkout. Local dev without keys → demo checkout. See PAYMENTS.md.
# Production MUST set at least one payment provider (Stripe, iDram, or TelCell).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional: pre-created Stripe Price IDs (Dashboard → Products). If empty, uses dynamic price_data in USD.
# STRIPE_PRICE_FARM_PRO_MONTHLY=""
# STRIPE_PRICE_FARM_PRO_YEARLY=""
# STRIPE_PRICE_BUYER_PRO_MONTHLY=""
# STRIPE_PRICE_VERIFIED_FARM_YEARLY=""
# STRIPE_PRICE_BOOST_7=""
# STRIPE_PRICE_BOOST_30=""

# Webhook URL (production): https://YOUR_DOMAIN/api/checkout/webhook
# Local test: stripe listen --forward-to localhost:3000/api/checkout/webhook

# ─── iDram (AMD wallet) ────────────────────────────────────────────────────
# Register merchant at idram.am — Idram sets RESULT_URL, SUCCESS_URL, FAIL_URL.
# Callback URL to give Idram: https://YOUR_DOMAIN/api/payments/idram/callback
# IDRAM_SECRET_KEY=""
# IDRAM_EDP_REC_ACCOUNT=""
# IDRAM_EDP_EMAIL=""
# IDRAM_CHECKOUT_BASE_URL="https://bank.idram.am/payment.aspx"

# ─── TelCell Wallet (AMD) ────────────────────────────────────────────────────
# Register at developer.telcell.am — callback URL in merchant settings.
# Callback URL: https://YOUR_DOMAIN/api/payments/telcell/callback
# TELCELL_MERCHANT_ID=""
# TELCELL_SECRET=""
# TELCELL_CHECKOUT_URL="https://telcellmoney.am/invoices"

# Optional default checkout provider: stripe | idram | telcell
# PAYMENT_PROVIDER=stripe

# Demo card checkout: include OTP in API response (testing only — never in production)
# DEMO_OTP_IN_RESPONSE=true

# ─── Admin ───────────────────────────────────────────────────────────────────
# Real admin email — promoted via npm run admin:promote or db:seed:minimal
ADMIN_EMAIL="you@example.com"
# Optional password when minimal seed creates admin (if user does not exist yet)
# ADMIN_PASSWORD="your-secure-password"

# ─── Demo vs production-like local dev ───────────────────────────────────────
# DEMO_MODE=true  → demo banners + demo checkout (local dev only, never production)
# DEMO_MODE=false → production-like UX (default for real deployments)
# When unset: demo auto-enables only if no payment provider is configured
# DEMO_MODE=false

# ─── Packages free launch ────────────────────────────────────────────────────
# PACKAGES_FREE=true → force all packages free (dev override)
# PACKAGES_FREE=false + EARLY_BIRD_FREE_LIMIT=100 → first 100 registrants free forever
# PACKAGES_FREE=false + EARLY_BIRD_FREE_LIMIT=0 → paid checkout only
PACKAGES_FREE=false
EARLY_BIRD_FREE_LIMIT=100

# ─── Farm OS weather ─────────────────────────────────────────────────────────
# Prefer OpenWeatherMap free API — see FARM_TOOLS.md
OPENWEATHER_API_KEY=
# If empty: Open-Meteo, then labeled demo. Optional:
# YANDEX_WEATHER_API_KEY=
# API: GET /api/weather?lat=&lng=  or  ?villageId=  or  ?marzId=

# ─── Footer social (optional) ───────────────────────────────────────────────
# NEXT_PUBLIC_SOCIAL_FACEBOOK=""
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
# NEXT_PUBLIC_SOCIAL_TELEGRAM=""

# ─── Docker only (optional) ──────────────────────────────────────────────────
# Host port published by docker compose (default 3000)
# APP_PORT=3000
# POSTGRES_PASSWORD=xndzor
