# ─── Database ───────────────────────────────────────────────────────────────
# Local / Docker SQLite (recommended for Armenia solo VPS launch):
DATABASE_URL="file:./dev.db"
# Docker Compose overrides this to: file:/data/prod.db (persistent volume)
#
# Optional later: Postgres (Neon / managed) — change prisma/schema.prisma
# provider to "postgresql" then set e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/farmos?sslmode=require"

# ─── Auth (required in production) ──────────────────────────────────────────
# Public site origin — MUST be https://your-domain in production (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Alias used by some Auth.js builds (set to the same value)
AUTH_URL="http://localhost:3000"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: email that can open /hy/admin/earnings (also role=ADMIN in DB)
ADMIN_EMAIL="you@yourdomain.com"

# ─── Stripe (optional until go-live) ─────────────────────────────────────────
# If unset/empty → checkout uses labeled test («դեմո») mode — no real charge.
# For live payments set all three and webhook → https://YOUR_DOMAIN/api/checkout/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Docker only (optional) ──────────────────────────────────────────────────
# Host port published by docker compose (default 3000)
# APP_PORT=3000
